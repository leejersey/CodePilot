# 数据库 — PostgreSQL
DATABASE_URL=postgresql+asyncpg://codepilot:dev_password@localhost:5433/codepilot

# Redis
REDIS_URL=redis://localhost:6380/0

# 远程 Judge0（标准托管服务）
JUDGE0_URL=https://judge0.example.com
JUDGE0_AUTH_HEADER=X-Auth-Token
JUDGE0_AUTH_TOKEN=your-judge0-token
# RapidAPI 时填写下面两项，并可留空 JUDGE0_AUTH_TOKEN
JUDGE0_RAPIDAPI_HOST=
JUDGE0_RAPIDAPI_KEY=
JUDGE0_TIMEOUT_SECONDS=20
JUDGE0_FAILURE_THRESHOLD=3
JUDGE0_COOLDOWN_SECONDS=30

# LLM — DeepSeek (OpenAI 兼容格式)
LLM_API_KEY=your-deepseek-api-key-here
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com
API_RATE_LIMIT_PER_MINUTE=120
LLM_RATE_LIMIT_PER_MINUTE=20
LLM_MAX_CONCURRENT_REQUESTS=3
LLM_MONTHLY_PLATFORM_TOKEN_QUOTA=1000000
LLM_QUOTA_RESERVE_OUTPUT_TOKENS=4096
# 每百万 Token 美元单价；请按供应商最新价格维护
LLM_PRICING_JSON={"deepseek-flash":{"input":0,"output":0}}

# Embeddings — 阿里云百炼 text-embedding-v3（OpenAI 兼容模式）
EMBEDDING_API_KEY=your-dashscope-api-key-here
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024

# 应用
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
ALERT_WEBHOOK_URL=
ALERT_COOLDOWN_SECONDS=300
ALERT_5XX_THRESHOLD_PER_MINUTE=5

# 超级管理员邮箱（逗号分隔）
ADMIN_EMAILS=admin@example.com

# 火山引擎 TOS（对话截图持久化；留空则仅当前轮 base64，刷新后不可回放）
TOS_ACCESS_KEY=
TOS_SECRET_KEY=
TOS_ENDPOINT=tos-cn-beijing.volces.com
TOS_REGION=cn-beijing
TOS_BUCKET=
# 可选：公开读 / CDN 域名；不填则用预签名 URL
TOS_PUBLIC_BASE_URL=
