# 数据库 — PostgreSQL
DATABASE_URL=postgresql+asyncpg://codepilot:dev_password@localhost:5432/codepilot

# Redis
REDIS_URL=redis://localhost:6380/0

# LLM — DeepSeek (OpenAI 兼容格式)
LLM_API_KEY=your-deepseek-api-key-here
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com

# Embeddings — 阿里云百炼 text-embedding-v3（OpenAI 兼容模式）
EMBEDDING_API_KEY=your-dashscope-api-key-here
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024

# 应用
APP_ENV=development
APP_DEBUG=true

# 管理员邮箱（逗号分隔）；匹配的账号登录/注册后为 admin，可管理知识库
ADMIN_EMAILS=admin@example.com
